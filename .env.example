# Register a confidential Twitch app with this exact OAuth redirect URL.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:5173/api/twitch/auth/callback
# ID of the broadcaster's custom "Pitch a mechanic" reward.
TWITCH_PITCH_REWARD_ID=
# Optional. Keep disabled when the simulator is no longer needed.
LIVE_PATCH_SIMULATOR_ENABLED=1
